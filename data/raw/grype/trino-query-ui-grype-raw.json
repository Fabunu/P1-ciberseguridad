{"matches":[{"vulnerability":{"id":"GHSA-crv5-9vww-q3g8","dataSource":"https://github.com/advisories/GHSA-crv5-9vww-q3g8","namespace":"github:language:javascript","severity":"Medium","urls":["https://github.com/cure53/DOMPurify/security/advisories/GHSA-crv5-9vww-q3g8","https://github.com/cure53/DOMPurify/releases/tag/3.4.0","https://nvd.nist.gov/vuln/detail/CVE-2026-41239"],"description":"DOMPurify has a SAFE_FOR_TEMPLATES bypass in RETURN_DOM mode","cvss":[{"type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:H/PR:N/UI:R/S:U/C:H/I:H/A:N","metrics":{"baseScore":6.8,"exploitabilityScore":1.7,"impactScore":5.2},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-41239","epss":0.00054,"percentile":0.16591,"date":"2026-05-05"}],"cwes":[{"cve":"CVE-2026-41239","cwe":"CWE-79","source":"security-advisories@github.com","type":"Primary"},{"cve":"CVE-2026-41239","cwe":"CWE-1289","source":"security-advisories@github.com","type":"Primary"}],"fix":{"versions":["3.4.0"],"state":"fixed","available":[{"version":"3.4.0","date":"2026-04-23","kind":"first-observed"}]},"advisories":[],"risk":0.03186},"relatedVulnerabilities":[{"id":"CVE-2026-41239","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2026-41239","namespace":"nvd:cpe","severity":"Medium","urls":["https://github.com/cure53/DOMPurify/releases/tag/3.4.0","https://github.com/cure53/DOMPurify/security/advisories/GHSA-crv5-9vww-q3g8"],"description":"DOMPurify is a DOM-only cross-site scripting sanitizer for HTML, MathML, and SVG. Starting in version 1.0.10 and prior to version 3.4.0, `SAFE_FOR_TEMPLATES` strips `{{...}}` expressions from untrusted HTML. This works in string mode but not with `RETURN_DOM` or `RETURN_DOM_FRAGMENT`, allowing XSS via template-evaluating frameworks like Vue 2. Version 3.4.0 patches the issue.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:H/PR:N/UI:R/S:U/C:H/I:H/A:N","metrics":{"baseScore":6.8,"exploitabilityScore":1.7,"impactScore":5.2},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-41239","epss":0.00054,"percentile":0.16591,"date":"2026-05-05"}],"cwes":[{"cve":"CVE-2026-41239","cwe":"CWE-79","source":"security-advisories@github.com","type":"Primary"},{"cve":"CVE-2026-41239","cwe":"CWE-1289","source":"security-advisories@github.com","type":"Primary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"javascript-matcher","searchedBy":{"language":"javascript","namespace":"github:language:javascript","package":{"name":"dompurify","version":"3.2.7"}},"found":{"vulnerabilityID":"GHSA-crv5-9vww-q3g8","versionConstraint":">=1.0.10,<3.4.0 (semantic)"},"fix":{"suggestedVersion":"3.4.0"}}],"artifact":{"id":"263556dd958cea87","name":"dompurify","version":"3.2.7","type":"npm","locations":[{"path":"/precise/package-lock.json","accessPath":"/precise/package-lock.json","annotations":{"evidence":"primary"}}],"language":"javascript","licenses":["(MPL-2.0 OR Apache-2.0)"],"cpes":["cpe:2.3:a:dompurify:dompurify:3.2.7:*:*:*:*:*:*:*"],"purl":"pkg:npm/dompurify@3.2.7","upstreams":[]}},{"vulnerability":{"id":"GHSA-48c2-rrv3-qjmp","dataSource":"https://github.com/advisories/GHSA-48c2-rrv3-qjmp","namespace":"github:language:javascript","severity":"Medium","urls":["https://github.com/eemeli/yaml/security/advisories/GHSA-48c2-rrv3-qjmp","https://github.com/eemeli/yaml/commit/1e84ebbea7ec35011a4c61bbb820a529ee4f359b","https://github.com/eemeli/yaml/releases/tag/v1.10.3","https://github.com/eemeli/yaml/releases/tag/v2.8.3","https://nvd.nist.gov/vuln/detail/CVE-2026-33532"],"description":"yaml is vulnerable to Stack Overflow via deeply nested YAML collections","cvss":[{"type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:N/A:L","metrics":{"baseScore":4.3,"exploitabilityScore":2.9,"impactScore":1.5},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-33532","epss":0.00062,"percentile":0.18901,"date":"2026-05-05"}],"cwes":[{"cve":"CVE-2026-33532","cwe":"CWE-674","source":"security-advisories@github.com","type":"Primary"}],"fix":{"versions":["1.10.3"],"state":"fixed","available":[{"version":"1.10.3","date":"2026-03-26","kind":"first-observed"}]},"advisories":[],"risk":0.028829999999999995},"relatedVulnerabilities":[{"id":"CVE-2026-33532","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2026-33532","namespace":"nvd:cpe","severity":"Medium","urls":["https://github.com/eemeli/yaml/commit/1e84ebbea7ec35011a4c61bbb820a529ee4f359b","https://github.com/eemeli/yaml/releases/tag/v1.10.3","https://github.com/eemeli/yaml/releases/tag/v2.8.3","https://github.com/eemeli/yaml/security/advisories/GHSA-48c2-rrv3-qjmp"],"description":"`yaml` is a YAML parser and serialiser for JavaScript. Parsing a YAML document with a version of `yaml` on the 1.x branch prior to 1.10.3 or on the 2.x branch prior to 2.8.3 may throw a RangeError due to a stack overflow. The node resolution/composition phase uses recursive function calls without a depth bound. An attacker who can supply YAML for parsing can trigger a `RangeError: Maximum call stack size exceeded` with a small payload (~2–10 KB). The `RangeError` is not a `YAMLParseError`, so applications that only catch YAML-specific errors will encounter an unexpected exception type. Depending on the host application's exception handling, this can fail requests or terminate the Node.js process. Flow sequences allow deep nesting with minimal bytes (2 bytes per level: one `[` and one `]`). On the default Node.js stack, approximately 1,000–5,000 levels of nesting (2–10 KB input) exhaust the call stack. The exact threshold is environment-dependent (Node.js version, stack size, call stack depth at invocation). Note: the library's `Parser` (CST phase) uses a stack-based iterative approach and is not affected. Only the compose/resolve phase uses actual call-stack recursion. All three public parsing APIs are affected: `YAML.parse()`, `YAML.parseDocument()`, and `YAML.parseAllDocuments()`. Versions 1.10.3 and 2.8.3 contain a patch.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:N/A:L","metrics":{"baseScore":4.3,"exploitabilityScore":2.9,"impactScore":1.5},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-33532","epss":0.00062,"percentile":0.18901,"date":"2026-05-05"}],"cwes":[{"cve":"CVE-2026-33532","cwe":"CWE-674","source":"security-advisories@github.com","type":"Primary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"javascript-matcher","searchedBy":{"language":"javascript","namespace":"github:language:javascript","package":{"name":"yaml","version":"1.10.2"}},"found":{"vulnerabilityID":"GHSA-48c2-rrv3-qjmp","versionConstraint":">=1.0.0,<1.10.3 (semantic)"},"fix":{"suggestedVersion":"1.10.3"}}],"artifact":{"id":"d5aa53a4e9316d7d","name":"yaml","version":"1.10.2","type":"npm","locations":[{"path":"/precise/package-lock.json","accessPath":"/precise/package-lock.json","annotations":{"evidence":"primary"}}],"language":"javascript","licenses":["ISC"],"cpes":["cpe:2.3:a:eemeli:yaml:1.10.2:*:*:*:*:node.js:*:*"],"purl":"pkg:npm/yaml@1.10.2","upstreams":[]}},{"vulnerability":{"id":"GHSA-v9jr-rg53-9pgp","dataSource":"https://github.com/advisories/GHSA-v9jr-rg53-9pgp","namespace":"github:language:javascript","severity":"Medium","urls":["https://github.com/cure53/DOMPurify/security/advisories/GHSA-v9jr-rg53-9pgp","https://github.com/cure53/DOMPurify/releases/tag/3.4.0","https://nvd.nist.gov/vuln/detail/CVE-2026-41238"],"description":"DOMPurify: Prototype Pollution to XSS Bypass via CUSTOM_ELEMENT_HANDLING Fallback","cvss":[{"type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:H/PR:N/UI:R/S:C/C:H/I:L/A:N","metrics":{"baseScore":6.9,"exploitabilityScore":1.7,"impactScore":4.8},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-41238","epss":0.00036,"percentile":0.1052,"date":"2026-05-05"}],"cwes":[{"cve":"CVE-2026-41238","cwe":"CWE-79","source":"security-advisories@github.com","type":"Secondary"},{"cve":"CVE-2026-41238","cwe":"CWE-1321","source":"security-advisories@github.com","type":"Secondary"}],"fix":{"versions":["3.4.0"],"state":"fixed","available":[{"version":"3.4.0","date":"2026-04-23","kind":"first-observed"}]},"advisories":[],"risk":0.02142},"relatedVulnerabilities":[{"id":"CVE-2026-41238","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2026-41238","namespace":"nvd:cpe","severity":"Medium","urls":["https://github.com/cure53/DOMPurify/releases/tag/3.4.0","https://github.com/cure53/DOMPurify/security/advisories/GHSA-v9jr-rg53-9pgp"],"description":"DOMPurify is a DOM-only cross-site scripting sanitizer for HTML, MathML, and SVG. Versions 3.0.1 through 3.3.3 are vulnerable to a prototype pollution-based XSS bypass. When an application uses `DOMPurify.sanitize()` with the default configuration (no `CUSTOM_ELEMENT_HANDLING` option), a prior prototype pollution gadget can inject permissive `tagNameCheck` and `attributeNameCheck` regex values into `Object.prototype`, causing DOMPurify to allow arbitrary custom elements with arbitrary attributes — including event handlers — through sanitization. Version 3.4.0 fixes the issue.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:H/PR:N/UI:R/S:C/C:H/I:L/A:N","metrics":{"baseScore":6.9,"exploitabilityScore":1.7,"impactScore":4.8},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-41238","epss":0.00036,"percentile":0.1052,"date":"2026-05-05"}],"cwes":[{"cve":"CVE-2026-41238","cwe":"CWE-79","source":"security-advisories@github.com","type":"Secondary"},{"cve":"CVE-2026-41238","cwe":"CWE-1321","source":"security-advisories@github.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"javascript-matcher","searchedBy":{"language":"javascript","namespace":"github:language:javascript","package":{"name":"dompurify","version":"3.2.7"}},"found":{"vulnerabilityID":"GHSA-v9jr-rg53-9pgp","versionConstraint":">=3.0.1,<3.4.0 (semantic)"},"fix":{"suggestedVersion":"3.4.0"}}],"artifact":{"id":"263556dd958cea87","name":"dompurify","version":"3.2.7","type":"npm","locations":[{"path":"/precise/package-lock.json","accessPath":"/precise/package-lock.json","annotations":{"evidence":"primary"}}],"language":"javascript","licenses":["(MPL-2.0 OR Apache-2.0)"],"cpes":["cpe:2.3:a:dompurify:dompurify:3.2.7:*:*:*:*:*:*:*"],"purl":"pkg:npm/dompurify@3.2.7","upstreams":[]}},{"vulnerability":{"id":"GHSA-h7mw-gpvr-xq4m","dataSource":"https://github.com/advisories/GHSA-h7mw-gpvr-xq4m","namespace":"github:language:javascript","severity":"Medium","urls":["https://github.com/cure53/DOMPurify/security/advisories/GHSA-h7mw-gpvr-xq4m","https://github.com/cure53/DOMPurify/releases/tag/3.4.0","https://nvd.nist.gov/vuln/detail/CVE-2026-41240","https://github.com/cure53/DOMPurify/commit/c361baa18dbdcb3344a41110f4c48ad85bf48f80"],"description":"DOMPurify: FORBID_TAGS bypassed by function-based ADD_TAGS predicate (asymmetry with FORBID_ATTR fix)","cvss":[{"type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:P/VC:N/VI:H/VA:N/SC:N/SI:N/SA:N","metrics":{"baseScore":6},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-41240","epss":0.00036,"percentile":0.1041,"date":"2026-05-05"}],"cwes":[{"cve":"CVE-2026-41240","cwe":"CWE-79","source":"security-advisories@github.com","type":"Secondary"},{"cve":"CVE-2026-41240","cwe":"CWE-183","source":"security-advisories@github.com","type":"Secondary"}],"fix":{"versions":["3.4.0"],"state":"fixed","available":[{"version":"3.4.0","date":"2026-04-23","kind":"first-observed"}]},"advisories":[],"risk":0.0198},"relatedVulnerabilities":[{"id":"CVE-2026-41240","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2026-41240","namespace":"nvd:cpe","severity":"Medium","urls":["https://github.com/cure53/DOMPurify/commit/c361baa18dbdcb3344a41110f4c48ad85bf48f80","https://github.com/cure53/DOMPurify/releases/tag/3.4.0","https://github.com/cure53/DOMPurify/security/advisories/GHSA-h7mw-gpvr-xq4m"],"description":"DOMPurify is a DOM-only cross-site scripting sanitizer for HTML, MathML, and SVG. Versions prior to 3.4.0 have an inconsistency between FORBID_TAGS and FORBID_ATTR handling when function-based ADD_TAGS is used. Commit c361baa added an early exit for FORBID_ATTR at line 1214. The same fix was not applied to FORBID_TAGS. At line 1118-1123, when EXTRA_ELEMENT_HANDLING.tagCheck returns true, the short-circuit evaluation skips the FORBID_TAGS check entirely. This allows forbidden elements to survive sanitization with their attributes intact. Version 3.4.0 patches the issue.","cvss":[{"source":"nvd@nist.gov","type":"Primary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:C/C:L/I:L/A:N","metrics":{"baseScore":6.1,"exploitabilityScore":2.9,"impactScore":2.8},"vendorMetadata":{}},{"source":"security-advisories@github.com","type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:P/VC:N/VI:H/VA:N/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","metrics":{"baseScore":6},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-41240","epss":0.00036,"percentile":0.1041,"date":"2026-05-05"}],"cwes":[{"cve":"CVE-2026-41240","cwe":"CWE-79","source":"security-advisories@github.com","type":"Secondary"},{"cve":"CVE-2026-41240","cwe":"CWE-183","source":"security-advisories@github.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"javascript-matcher","searchedBy":{"language":"javascript","namespace":"github:language:javascript","package":{"name":"dompurify","version":"3.2.7"}},"found":{"vulnerabilityID":"GHSA-h7mw-gpvr-xq4m","versionConstraint":"<3.4.0 (semantic)"},"fix":{"suggestedVersion":"3.4.0"}}],"artifact":{"id":"263556dd958cea87","name":"dompurify","version":"3.2.7","type":"npm","locations":[{"path":"/precise/package-lock.json","accessPath":"/precise/package-lock.json","annotations":{"evidence":"primary"}}],"language":"javascript","licenses":["(MPL-2.0 OR Apache-2.0)"],"cpes":["cpe:2.3:a:dompurify:dompurify:3.2.7:*:*:*:*:*:*:*"],"purl":"pkg:npm/dompurify@3.2.7","upstreams":[]}},{"vulnerability":{"id":"GHSA-v2wj-7wpq-c8vv","dataSource":"https://github.com/advisories/GHSA-v2wj-7wpq-c8vv","namespace":"github:language:javascript","severity":"Medium","urls":["https://nvd.nist.gov/vuln/detail/CVE-2026-0540","https://github.com/cure53/DOMPurify/commit/fca0a938b4261ddc9c0293a289935a9029c049f5","https://github.com/cure53/DOMPurify","https://www.vulncheck.com/advisories/dompurify-xss-via-missing-rawtext-elements-in-safe-for-xml","https://github.com/cure53/DOMPurify/commit/302b51de22535cc90235472c52e3401bedd46f80","https://fluidattacks.com/advisories/daft","https://github.com/cure53/DOMPurify/releases/tag/3.3.2"],"description":"DOMPurify contains a Cross-site Scripting vulnerability","cvss":[{"type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:C/C:L/I:L/A:N","metrics":{"baseScore":6.1,"exploitabilityScore":2.9,"impactScore":2.8},"vendorMetadata":{}},{"type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:A/VC:N/VI:N/VA:N/SC:L/SI:L/SA:N","metrics":{"baseScore":5.1},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-0540","epss":0.00013,"percentile":0.0192,"date":"2026-05-05"}],"cwes":[{"cve":"CVE-2026-0540","cwe":"CWE-79","source":"help@fluidattacks.com","type":"Secondary"}],"fix":{"versions":["3.3.2"],"state":"fixed","available":[{"version":"3.3.2","date":"2026-03-06","kind":"first-observed"}]},"advisories":[],"risk":0.006889999999999999},"relatedVulnerabilities":[{"id":"CVE-2026-0540","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2026-0540","namespace":"nvd:cpe","severity":"Medium","urls":["https://fluidattacks.com/advisories/daft","https://github.com/cure53/DOMPurify","https://github.com/cure53/DOMPurify/commit/302b51de22535cc90235472c52e3401bedd46f80","https://github.com/cure53/DOMPurify/releases/tag/3.3.2","https://www.vulncheck.com/advisories/dompurify-xss-via-missing-rawtext-elements-in-safe-for-xml"],"description":"DOMPurify 3.1.3 through 3.3.1 and 2.5.3 through 2.5.8, fixed in commit 2726c74, contain a cross-site scripting vulnerability that allows attackers to bypass attribute sanitization by exploiting five missing rawtext elements (noscript, xmp, noembed, noframes, iframe) in the SAFE_FOR_XML regex. Attackers can include payloads like </noscript><img src=x onerror=alert(1)> in attribute values to execute JavaScript when sanitized output is placed inside these unprotected rawtext contexts.","cvss":[{"source":"help@fluidattacks.com","type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:P/VC:N/VI:N/VA:N/SC:L/SI:L/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","metrics":{"baseScore":5.3},"vendorMetadata":{}},{"source":"help@fluidattacks.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:C/C:L/I:L/A:N","metrics":{"baseScore":6.1,"exploitabilityScore":2.9,"impactScore":2.8},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-0540","epss":0.00013,"percentile":0.0192,"date":"2026-05-05"}],"cwes":[{"cve":"CVE-2026-0540","cwe":"CWE-79","source":"help@fluidattacks.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"javascript-matcher","searchedBy":{"language":"javascript","namespace":"github:language:javascript","package":{"name":"dompurify","version":"3.2.7"}},"found":{"vulnerabilityID":"GHSA-v2wj-7wpq-c8vv","versionConstraint":">=3.1.3,<=3.3.1 (semantic)"},"fix":{"suggestedVersion":"3.3.2"}}],"artifact":{"id":"263556dd958cea87","name":"dompurify","version":"3.2.7","type":"npm","locations":[{"path":"/precise/package-lock.json","accessPath":"/precise/package-lock.json","annotations":{"evidence":"primary"}}],"language":"javascript","licenses":["(MPL-2.0 OR Apache-2.0)"],"cpes":["cpe:2.3:a:dompurify:dompurify:3.2.7:*:*:*:*:*:*:*"],"purl":"pkg:npm/dompurify@3.2.7","upstreams":[]}},{"vulnerab